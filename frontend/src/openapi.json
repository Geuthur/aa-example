{
  "openapi": "3.1.0",
  "info": {
    "title": "Example API",
    "version": "0.5.0",
    "description": ""
  },
  "paths": {
    "/example/api/characters/": {
      "get": {
        "operationId": "example_api_character_list_characters",
        "summary": "List the characters visible to the user",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CharacterSchema"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          }
        },
        "tags": [
          "Characters"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/example/api/characters/{character_id}/": {
      "get": {
        "operationId": "example_api_character_get_character",
        "summary": "Get a character with the status of its sections",
        "parameters": [
          {
            "in": "path",
            "name": "character_id",
            "schema": {
              "title": "Character Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CharacterDetailSchema"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          }
        },
        "tags": [
          "Characters"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/example/api/characters/{character_id}/update/": {
      "post": {
        "operationId": "example_api_character_update_character",
        "summary": "Queue an update of a character",
        "parameters": [
          {
            "in": "path",
            "name": "character_id",
            "schema": {
              "title": "Character Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          }
        },
        "tags": [
          "Characters"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ForceRefreshRequest"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "required": false
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/example/api/menu/": {
      "get": {
        "operationId": "example_api_general_get_menu",
        "summary": "Get Example navigation menu",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuSchema"
                }
              }
            }
          }
        },
        "tags": [
          "General"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/example/api/user/": {
      "get": {
        "operationId": "example_api_general_get_user",
        "summary": "Get User",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserData"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          }
        },
        "tags": [
          "General"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/example/api/settings/": {
      "get": {
        "operationId": "example_api_general_get_user_settings",
        "summary": "Get current user's settings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSettingsSchema"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          }
        },
        "tags": [
          "General"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      },
      "put": {
        "operationId": "example_api_general_update_user_settings",
        "summary": "Update current user's settings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSettingsSchema"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          }
        },
        "tags": [
          "General"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserSettingsUpdateRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CharacterSchema": {
        "description": "A character owner as shown in the character list.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "character_id": {
            "title": "Character Id",
            "type": "integer"
          },
          "character_name": {
            "title": "Character Name",
            "type": "string"
          },
          "corporation_id": {
            "title": "Corporation Id",
            "type": "integer"
          },
          "corporation_name": {
            "title": "Corporation Name",
            "type": "string"
          },
          "portrait_url": {
            "title": "Portrait Url",
            "type": "string"
          },
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "wallet_balance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wallet Balance"
          },
          "update_status": {
            "title": "Update Status",
            "type": "string"
          },
          "update_status_label": {
            "title": "Update Status Label",
            "type": "string"
          },
          "last_update": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Update"
          }
        },
        "required": [
          "id",
          "character_id",
          "character_name",
          "corporation_id",
          "corporation_name",
          "portrait_url",
          "active",
          "update_status",
          "update_status_label"
        ],
        "title": "CharacterSchema",
        "type": "object"
      },
      "ErrorSchema": {
        "description": "Error response of an endpoint, e.g. for 403 and 404.",
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorSchema",
        "type": "object"
      },
      "CharacterDetailSchema": {
        "description": "A character owner with the status of every section.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "character_id": {
            "title": "Character Id",
            "type": "integer"
          },
          "character_name": {
            "title": "Character Name",
            "type": "string"
          },
          "corporation_id": {
            "title": "Corporation Id",
            "type": "integer"
          },
          "corporation_name": {
            "title": "Corporation Name",
            "type": "string"
          },
          "portrait_url": {
            "title": "Portrait Url",
            "type": "string"
          },
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "wallet_balance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wallet Balance"
          },
          "update_status": {
            "title": "Update Status",
            "type": "string"
          },
          "update_status_label": {
            "title": "Update Status Label",
            "type": "string"
          },
          "last_update": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Update"
          },
          "sections": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/CharacterUpdateStatusSchema"
            },
            "title": "Sections",
            "type": "array"
          }
        },
        "required": [
          "id",
          "character_id",
          "character_name",
          "corporation_id",
          "corporation_name",
          "portrait_url",
          "active",
          "update_status",
          "update_status_label"
        ],
        "title": "CharacterDetailSchema",
        "type": "object"
      },
      "CharacterUpdateStatusSchema": {
        "description": "Update status of one section of a character.",
        "properties": {
          "section": {
            "title": "Section",
            "type": "string"
          },
          "section_label": {
            "title": "Section Label",
            "type": "string"
          },
          "is_success": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Success"
          },
          "has_token_error": {
            "default": false,
            "title": "Has Token Error",
            "type": "boolean"
          },
          "error_message": {
            "default": "",
            "title": "Error Message",
            "type": "string"
          },
          "last_run_finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Run Finished At"
          },
          "last_update_finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Update Finished At"
          }
        },
        "required": [
          "section",
          "section_label"
        ],
        "title": "CharacterUpdateStatusSchema",
        "type": "object"
      },
      "ActionResponse": {
        "description": "Response of an action endpoint, e.g. after queueing a task.",
        "properties": {
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "title": "ActionResponse",
        "type": "object"
      },
      "ForceRefreshRequest": {
        "description": "Request body of update endpoints.",
        "properties": {
          "force_refresh": {
            "default": false,
            "title": "Force Refresh",
            "type": "boolean"
          }
        },
        "title": "ForceRefreshRequest",
        "type": "object"
      },
      "MenuLink": {
        "description": "Represents a link in the menu.\n\nParameters:\n    name (str): The name of the menu link.\n    link (str | None): The URL or path the menu link points to.\n    is_external (bool): Indicates if the link is an external link.\n    badge (int | None): Number of issues shown as badge next to the link.\n    has_errors (bool): Whether the badge pulses because of active errors.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "link": {
            "title": "Link",
            "type": "string"
          },
          "is_external": {
            "default": false,
            "title": "Is External",
            "type": "boolean"
          },
          "badge": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Badge"
          },
          "has_errors": {
            "default": false,
            "title": "Has Errors",
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "title": "MenuLink",
        "type": "object"
      },
      "MenuModalSchema": {
        "description": "Schema for menu modals, including the example modal.",
        "properties": {
          "create_example": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModalSchema"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "MenuModalSchema",
        "type": "object"
      },
      "MenuSchema": {
        "description": "Schema for the overall menu, including links and modals.\n\nParameters:\n    links (list[MenuLink]): The list of links in the menu.\n    modals (MenuModalSchema | None): The modals associated with the menu.",
        "properties": {
          "left_links": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/MenuLink"
            },
            "title": "Left Links",
            "type": "array"
          },
          "right_links": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/MenuLink"
            },
            "title": "Right Links",
            "type": "array"
          },
          "modals": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MenuModalSchema"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "MenuSchema",
        "type": "object"
      },
      "ModalSchema": {
        "description": "Schema for modal dialog data.",
        "properties": {
          "title": {
            "title": "Title",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "icon": {
            "title": "Icon",
            "type": "string"
          },
          "modal_id": {
            "title": "Modal Id",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          },
          "color": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color"
          },
          "buttonText": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Buttontext"
          }
        },
        "required": [
          "title",
          "text",
          "icon",
          "modal_id",
          "url"
        ],
        "title": "ModalSchema",
        "type": "object"
      },
      "UserData": {
        "description": "Schema for user data, including character ID and character name.\n\nParameters:\n    user_id (int): The ID of the user.\n    character_id (int): The ID of the character associated with the user.\n    character_name (str): The name of the character.\n    corporation_id (int): The ID of the corporation associated with the user.\n    corporation_name (str): The name of the corporation associated with the user.\n    alliance_id (int | None): The ID of the alliance associated with the user, if any.\n    alliance_name (str | None): The name of the alliance associated with the user, if any.\n    portrait (str | None): The URL or path to the character's portrait image.\n    is_admin (boolean): The admin status for the user.",
        "properties": {
          "user_id": {
            "title": "User Id",
            "type": "integer"
          },
          "character_id": {
            "title": "Character Id",
            "type": "integer"
          },
          "character_name": {
            "title": "Character Name",
            "type": "string"
          },
          "corporation_id": {
            "title": "Corporation Id",
            "type": "integer"
          },
          "corporation_name": {
            "title": "Corporation Name",
            "type": "string"
          },
          "alliance_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alliance Id"
          },
          "alliance_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alliance Name"
          },
          "portrait": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portrait"
          },
          "is_admin": {
            "default": false,
            "title": "Is Admin",
            "type": "boolean"
          }
        },
        "required": [
          "user_id",
          "character_id",
          "character_name",
          "corporation_id",
          "corporation_name"
        ],
        "title": "UserData",
        "type": "object"
      },
      "UserSettingsSchema": {
        "properties": {
          "disable_notifications": {
            "title": "Disable Notifications",
            "type": "boolean"
          }
        },
        "required": [
          "disable_notifications"
        ],
        "title": "UserSettingsSchema",
        "type": "object"
      },
      "UserSettingsUpdateRequest": {
        "properties": {
          "disable_notifications": {
            "title": "Disable Notifications",
            "type": "boolean"
          }
        },
        "required": [
          "disable_notifications"
        ],
        "title": "UserSettingsUpdateRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  },
  "servers": []
}