  "components": {
    "schemas": {
      "ExampleSchema": {
        "properties": {
          "character_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Character Id"
          },
          "character_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Character Name"
          },
          "corporation_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corporation Id"
          },
          "corporation_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corporation Name"
          }
        },
        "title": "ExampleSchema",
        "type": "object"
      },
      "MenuLink": {
        "description": "Represents a link in the menu.\n\nParameters:\n    name (str): The name of the menu link.\n    link (str | None): The URL or path the menu link points to.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "link": {
            "title": "Link",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "MenuLink",
        "type": "object"
      },
      "MenuModalSchema": {
        "description": "Schema for menu modals, including the example modal.",
        "properties": {
          "create_example": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModalSchema"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "MenuModalSchema",
        "type": "object"
      },
      "MenuSchema": {
        "description": "Schema for the overall menu, including links and modals.\n\nParameters:\n    links (list[MenuLink]): The list of links in the menu.\n    modals (MenuModalSchema | None): The modals associated with the menu.",
        "properties": {
          "links": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/MenuLink"
            },
            "title": "Links",
            "type": "array"
          },
          "modals": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MenuModalSchema"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "MenuSchema",
        "type": "object"
      },
      "ModalSchema": {
        "description": "Schema for modal dialog data.",
        "properties": {
          "title": {
            "title": "Title",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "icon": {
            "title": "Icon",
            "type": "string"
          },
          "modal_id": {
            "title": "Modal Id",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          },
          "color": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color"
          },
          "buttonText": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Buttontext"
          }
        },
        "required": [
          "title",
          "text",
          "icon",
          "modal_id",
          "url"
        ],
        "title": "ModalSchema",
        "type": "object"
      },
      "UserData": {
        "description": "Schema for user data, including character ID and character name.\n\nParameters:\n    user_id (int): The ID of the user.\n    character_id (int): The ID of the character associated with the user.\n    character_name (str): The name of the character.\n    portrait (str | None): The URL or path to the character's portrait image.\n    notification (boolean): The notification status for the user.",
        "properties": {
          "user_id": {
            "title": "User Id",
            "type": "integer"
          },
          "character_id": {
            "title": "Character Id",
            "type": "integer"
          },
          "character_name": {
            "title": "Character Name",
            "type": "string"
          },
          "portrait": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portrait"
          },
          "notification": {
            "title": "Notification",
            "type": "boolean"
          }
        },
        "required": [
          "user_id",
          "character_id",
          "character_name",
          "notification"
        ],
        "title": "UserData",
        "type": "object"
      }
